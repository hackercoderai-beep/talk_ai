# Neon Postgres connection string (drizzle-orm/neon-http)
DATABASE_URL=

# better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth providers — both client id and secret are required for each enabled
# provider; src/lib/auth.ts throws at startup if either half is missing.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
